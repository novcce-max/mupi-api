# ============================================
# Mupi.cn Development Environment
# ============================================

NODE_ENV=development
PORT=3001

# ========
# Database
# ========
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=mupi_user
DB_PASSWORD=
DB_DATABASE=mupi_dev

# ===
# JWT
# ===
JWT_SECRET=mupi-dev-secret-change-in-production

# ======================
# Admin / 内部安全配置
# ======================
# Next.js 服务端调用后端 /api/admin/** 的内部密钥（前后端必须一致）
INTERNAL_RPC_TOKEN=dev-internal-token

# =====
# CORS
# =====
# 开发环境默认放开；如需限制：http://localhost:3000
CORS_ORIGIN=
