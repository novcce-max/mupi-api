NODE_ENV=production
PORT=3001

# Database (preferred)
DATABASE_URL=postgres://mupi_user:REPLACE_DB_PASSWORD@db-host:5432/mupi_prod

# Or use split fields instead of DATABASE_URL
# DB_HOST=db-host
# DB_PORT=5432
# DB_USERNAME=mupi_user
# DB_PASSWORD=REPLACE_DB_PASSWORD
# DB_DATABASE=mupi_prod

# Optional Redis (if empty, app falls back to in-memory cache/throttle)
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis-host:6379/0

# Security
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32
INTERNAL_RPC_TOKEN=REPLACE_INTERNAL_RPC_TOKEN
# INTERNAL_RPC_TOKENS=token_a,token_b
CONTACT_ADMIN_KEY=REPLACE_CONTACT_ADMIN_KEY

# Optional hardening / integrations
ADMIN_TRUSTED_IPS=
FRONTEND_BASE_URL=https://www.mupi.cn

# Optional seed script credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
