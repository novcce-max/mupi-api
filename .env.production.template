# =============================================================================
# mupi-api 生产环境变量（仅服务器 / 密钥管理平台，勿提交真实值到 Git）
# =============================================================================
# 与 mupi-web 对照说明：凡标注「↔ 前端」的项，须与 mupi-web/.env.production 同名或对应项一致。
# 详表：mupi-web/docs/DEPLOY_ENV_CLOUDFLARE.md
# 上线逐项核对：mupi-web/docs/DEPLOY_GO_LIVE_CHECKLIST.md
#
# 后端无同名变量、但须与前端一致的概念：
#   • mupi-web NEXT_PUBLIC_API_URL = 本 API 的公网根地址（浏览器请求用）；服务端代调可用 MUPI_API_SERVER_ORIGIN。
# =============================================================================

NODE_ENV=production
# 与 mupi-web NODE_ENV 均用 production 即可（无同名变量，仅环境一致）

PORT=3001
# 仅 API 监听端口；前端无此项

# ↔ 前端：须包含 mupi-web 的 NEXT_PUBLIC_SITE_URL 来源（浏览器跨域）。例中含 www 与裸域。
ALLOWED_ORIGINS=https://www.mupi.cn,https://mupi.cn

# ---------- [A] 数据库 / 缓存 ----------
# 仅后端；mupi-web 无对应变量（勿把连接串写进 NEXT_PUBLIC_*）
DB_HOST=172.17.0.1
DB_PORT=5432
DB_DATABASE=mupi_sql
DB_USERNAME=mupi_user
DB_PASSWORD=REPLACE_DB_PASSWORD

DATABASE_URL=postgres://mupi_user:REPLACE_DB_PASSWORD@172.17.0.1:5432/mupi_sql

DISABLE_DATABASE=false

REDIS_URL=redis://mupi-redis:6379/0

# ---------- [B] 鉴权 / 内部调用（与 mupi-web 对照见各注释）----------
# JWT_SECRET：仅 API，签/验会员 Bearer Token；勿写入 mupi-web，前端无同名变量
JWT_SECRET=REPLACE_JWT_SECRET

# INTERNAL_RPC_TOKEN：↔ mupi-web 同名变量逐字相同；Next 代调 API 时头 X-Internal-Secret
INTERNAL_RPC_TOKEN=REPLACE_INTERNAL_RPC_TOKEN

# CONTACT_ADMIN_KEY：↔ mupi-web CONTACT_ADMIN_KEY 逐字相同；Next 请求头 X-Admin-Key；建议 web 的 CONTENT_ADMIN_KEY 同值
CONTACT_ADMIN_KEY=REPLACE_CONTACT_ADMIN_KEY

# ---------- [C] 管理后台账号（与 Next /admin 登录一致）----------
# ↔ 前端：须与 mupi-web ADMIN_USERNAME 相同
ADMIN_USERNAME=admin
# ↔ 前端：须与 mupi-web ADMIN_PASSWORD 相同
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD

# ---------- [D] Cloudflare R2 图床（仅 API 持有密钥）----------
# ↔ 前端：mupi-web 须设 ADMIN_MEDIA_STORAGE=r2，且 INTERNAL_RPC_TOKEN 已对齐，上传才走通
# 控制台：R2 → 桶 → S3 兼容访问密钥（非 cfat_ 网页 Token）
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
R2_BUCKET=mupi
# 公网图片根 URL（不要末尾 /）；与桶绑定自定义域一致，如前端的图片地址用此域
R2_PUBLIC_BASE_URL=https://img.mupi.cn

# ---------- [E] AI ----------
# 流程说明（国内机房）：
#   • 业务 prompt 在 mupi-api 里组装；真正访问 api.openai.com 的请求发到**境外 mupi-ai** 的 /api/llm。
#   • 因此**境内可以不写 OPENAI_API_KEY**，只写 MUPI_AI_LLM_URL + 与境外一致的入站密钥即可。
#   • 详见仓库根目录 ENV.md「§6 AI」。
#
# —— 开关：openai = 启用「CMS 全文 AI 草稿」+「文章编辑页 AI 助手」；不配 URL 且无 OPENAI_API_KEY 时为占位/stub ——
CONTENT_AI_DRIVER=openai
#
# —— 【推荐 · 境外转发】mupi-ai 上已部署 /api/llm 后，把域名换成你的真实地址 ——
MUPI_AI_LLM_URL=https://YOUR_MUPI_AI.vercel.app/api/llm
#
# —— 【选填】转发时请求头 X-Internal-Secret 用的字符串，必须与 mupi-ai 环境变量一致 ——
# 若不写本行：mupi-api 会自动用上面的 INTERNAL_RPC_TOKEN 当 Secret（此时 mupi-ai 控制台也配 INTERNAL_RPC_TOKEN 即可，少配一个名）。
# MUPI_AI_INGRESS_SECRET=REPLACE_OR_OMIT_TO_USE_INTERNAL_RPC_TOKEN
#
# —— 【选填 · 直连】仅当本机/境外能访问 api.openai.com 时使用；与 MUPI_AI_LLM_URL 同时存在时**优先走转发 URL** ——
# OPENAI_API_KEY=
#
# 传给 OpenAI 的模型名（经 /api/llm 原样转发）
OPENAI_MODEL=gpt-4o-mini
#
# —— 【选填 · 百科旧链路】管理端若仍调用 AiService → MUPI_AI_GENERATE_URL，须与 mupi-ai 的 /api/generate 入参、返回 { wiki } 对齐后再填 ——
# MUPI_AI_GENERATE_URL=https://YOUR_MUPI_AI.vercel.app/api/generate

# ↔ 前端：须与 mupi-web NEXT_PUBLIC_SITE_URL 一致（邮件/跳转/CORS 相关，勿加末尾 /）
FRONTEND_BASE_URL=https://www.mupi.cn

# ---------- [F] 会员邮件（仅后端）----------
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@mupi.cn
SMTP_PASS=REPLACE_ALIYUN_CLIENT_SMTP_PASSWORD
MAIL_FROM="通知 <noreply@mupi.cn>"

# ↔ 前端：须与 mupi-web NEXT_PUBLIC_SITE_URL 一致（重置密码等邮件里的链接域名）
MEMBER_PUBLIC_ORIGIN=https://www.mupi.cn
# PUBLIC_SITE_URL=https://www.mupi.cn
