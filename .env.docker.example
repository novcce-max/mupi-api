# 复制为 .env.docker 后填写真实值（勿提交 .env.docker）
# docker compose -f docker-compose.stack.yml --env-file .env.docker up -d --build
#
# Compose 会再注入：DATABASE_URL / DB_HOST / REDIS_URL / TYPEORM_SYNC / RUN_SQL_MIGRATIONS

# ---------- 与 compose 共用（DB_PASSWORD 同时给 Postgres 容器与 API）----------
DB_PASSWORD=REPLACE_STRONG_DB_PASSWORD

# ---------- 首次部署：true=按实体自动建表；有数据后改为 false ----------
TYPEORM_SYNC=true
# ---------- 启动后执行 scripts/migrations/*.sql（与 apply-migrations.sh 一致）----------
RUN_SQL_MIGRATIONS=true

# ---------- 可选：映射端口（compose 里 ${POSTGRES_PORT} 等）----------
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=3001

# ---------- 与生产模板一致的业务变量（须自行替换）----------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=REPLACE_JWT_SECRET
INTERNAL_RPC_TOKEN=REPLACE_INTERNAL_RPC_TOKEN
CONTACT_ADMIN_KEY=REPLACE_CONTACT_ADMIN_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD_STRONG

# R2 / 邮件等按需从 .env.production.template 拷贝

FRONTEND_BASE_URL=http://localhost:3000
MEMBER_PUBLIC_ORIGIN=http://localhost:3000
